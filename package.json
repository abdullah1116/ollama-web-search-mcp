{
  "name": "ollama-web-search-mcp",
  "version": "1.2.0",
  "description": "MCP server exposing Ollama web_search and web_fetch as tools",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdullah1116/ollama-web-search-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/abdullah1116/ollama-web-search-mcp/issues"
  },
  "homepage": "https://github.com/abdullah1116/ollama-web-search-mcp#readme",
  "main": "build/index.js",
  "bin": {
    "ollama-web-search-mcp": "build/index.js"
  },
  "files": [
    "build",
    "scripts",
    "systemd"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts src/server.ts --bundle --format=esm --platform=node --target=node18 --outdir=build --tree-shaking=true && chmod 755 build/index.js",
    "dev": "node --import tsx src/index.ts",
    "start": "node build/index.js",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  }
}
